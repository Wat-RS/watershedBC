pour_x = point_df$lon,
pour_y = point_df$lat)}else{
new_ws2_4326 <- st_read(gsub("/dem.tif","/watershed.shp",dem_temp_path))
}
if(!sf::st_is_valid(new_ws2_4326)){
file.remove(gsub("/dem.tif","/watershed.shp",dem_temp_path))
st_write(new_ws2_4326 %>% st_make_valid(), gsub("/dem.tif","/watershed.shp",dem_temp_path))
new_ws2_4326 <- st_read(gsub("/dem.tif","/watershed.shp",dem_temp_path))
}
# if(!file.exists(out_name)){
