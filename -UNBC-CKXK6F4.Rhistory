station_id <- point_df$id
station_name <- point_df$name
print(station_name)
# out_fol <- "batch_Stephen/newoutput2/"
out_fol <- file.path(working_dir, "20260813_outputs")
dir.create(out_fol, showWarnings = F)
write.table("", file.path(out_fol, paste0(station_id,"_",station_name,"_", name, ".txt")))
out_name <- file.path(out_fol, paste0(station_id,"_",station_name,"_", name, ".sqlite"))
print(out_name)
# GET CLICK POINT ####
print("- POINT")
pt_sf <- point_df %>% st_as_sf(coords = c("lon","lat"), crs = 4326) %>% st_transform(3005)
point_df_3005 <- pt_sf %>% st_coordinates()
# mapview::mapview(pt_sf)
# GET WATERSHED ####
print("- WATERSHED")
# conn
ws <- st_read(conn, query = paste0("SELECT * FROM ", name,
" WHERE ST_DWithin(geom, ST_Transform(ST_SetSRID(ST_MakePoint(",
point_df$lon, ",", point_df$lat, "), 4326), 3005), ",
100, ")
ORDER BY area_m2 ASC LIMIT 1"))
