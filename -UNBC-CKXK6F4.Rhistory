delineate_watershed <- function(dem_path,
pour_x,
pour_y,
crs = 4326,
output_path = NULL,
snap_dist = 500,
stream_threshold = 500,
return_raster = FALSE) {
# Load required libraries
if (!require("whitebox")) stop("Package 'whitebox' is required")
if (!require("sf")) stop("Package 'sf' is required")
if (!require("terra")) stop("Package 'terra' is required")
# Force single-threaded WBT so runs are reproducible
wbt_max_procs(1)
# Two separate caches:
#   dem_folder   - conditioning products, shared across all pour points
#   temp_folder  - per-outlet products, must never be shared
dem_folder <- file.path(dirname(dem_path), "dem_conditioning")
temp_folder <- file.path(dirname(dem_path), "ws")
dir.create(dem_folder, showWarnings = FALSE, recursive = TRUE)
dir.create(temp_folder, showWarnings = FALSE, recursive = TRUE)
message("Processing watershed delineation...")
message(paste("DEM conditioning directory:", dem_folder))
message(paste("Temporary files directory:", temp_folder))
# Define DEM conditioning file paths (shared)
dem_3005 <- file.path(dem_folder, "dem_3005.tif")
breached_dem <- file.path(dem_folder, "breached_dem.tif")
filled_dem <- file.path(dem_folder, "filled_dem.tif")
flow_dir <- file.path(dem_folder, "flow_direction.tif")
flow_accum <- file.path(dem_folder, "flow_accumulation.tif")
stream_rast <- file.path(dem_folder, "streams.tif")
# Define per-outlet file paths
pour_point_shp <- file.path(temp_folder, "pour_point.shp")
snapped_point <- file.path(temp_folder, "snapped_point.shp")
watershed_rast <- file.path(temp_folder, "watershed.tif")
watershed_vect <- file.path(temp_folder, "watershed.shp")
# flat_increment in DEM z units (m). Pinned so it is not re-derived
# per run, and kept well above float32 precision at typical elevations.
flat_inc <- 0.001
tryCatch({
# Step 1: Create pour point shapefile
message("Step 1/7: Creating pour point...")
pour_point <- st_sfc(st_point(c(pour_x, pour_y)), crs = crs) %>% st_transform(3005)
pour_point_sf <- st_sf(id = 1, geometry = pour_point)
# Reproject DEM to BC Albers only if it is not already there
dem_raster <- rast(dem_path)
dem_code <- terra::crs(dem_raster, describe = TRUE)$code
# plot(dem_raster)
if (!is.na(dem_code) && dem_code == "3005") {
dem_3005 <- dem_path
} else if (!file.exists(dem_3005)) {
sf::gdal_utils(util = "warp",
source = dem_path,
destination = dem_3005,
options = c("-t_srs", "EPSG:3005",
"-r", "bilinear",
"-ot", "Float64"))}
if (file.exists(pour_point_shp)) {
file.remove(pour_point_shp)
file.remove(gsub("*.shp", ".prj", pour_point_shp))
file.remove(gsub("*.shp", ".dbf", pour_point_shp))
file.remove(gsub("*.shp", ".shx", pour_point_shp))}
st_write(pour_point_sf, pour_point_shp)
# Step 2: Breach then fill depressions
message("Step 2/7: Conditioning DEM (breach + fill)...")
if (!file.exists(filled_dem)) {
wbt_breach_depressions(
dem = dem_3005,
output = breached_dem,
flat_increment = flat_inc,
verbose_mode = FALSE)
# Breaching alone does not guarantee a depressionless surface.
# Fill whatever it could not carve out.
wbt_fill_depressions(
dem = breached_dem,
output = filled_dem,
fix_flats = TRUE,
flat_increment = flat_inc,
verbose_mode = FALSE)}
# NOTE: the terra round-trip that used to sit here has been removed.
# It wrote FLT4S by default, which quantised the breach increments
# away and left large flats for D8 to resolve arbitrarily. If you
# need it back for a metadata reason, it MUST be:
#   writeRaster(r, ..., datatype = "FLT8S", overwrite = TRUE)
# plot(rast(filled_dem))
# Step 3: Generate flow direction
message("Step 3/7: Calculating flow direction...")
if (!file.exists(flow_dir)) {
wbt_d8_pointer(
dem = filled_dem,
output = flow_dir,
verbose_mode = FALSE
)}
# Step 4: Generate flow accumulation
message("Step 4/7: Calculating flow accumulation...")
if (!file.exists(flow_accum)) {
wbt_d8_flow_accumulation(
input = filled_dem,
output = flow_accum,
verbose_mode = FALSE
)}
# threshold is in CELLS, so it means different things at different
# DEM resolutions. Exposed as an argument rather than hardcoded.
if (!file.exists(stream_rast)) {
wbt_extract_streams(
flow_accum = flow_accum,
output = stream_rast,
threshold = stream_threshold,
verbose_mode = FALSE)}
# Step 5: Snap pour point to stream
message("Step 5/7: Snapping pour point to stream...")
if (!file.exists(snapped_point)) {
wbt_jenson_snap_pour_points(
pour_pts = pour_point_shp,
streams = stream_rast,
output = snapped_point,
snap_dist = snap_dist,
verbose_mode = FALSE)    }
# Report how far the point actually moved. A snap of more than a few
# cell widths means the outlet may have jumped to a different channel.
snapped_sf <- st_read(snapped_point, quiet = TRUE)
snap_moved <- as.numeric(st_distance(pour_point_sf, snapped_sf))
dem_res <- res(rast(filled_dem))[1]
message(paste("Snap displacement:", round(snap_moved, 1), "m /",
round(snap_moved / dem_res, 1), "cells"))
if (snap_moved > 5 * dem_res) {
warning(paste("Pour point snapped", round(snap_moved, 1),
"m. Verify it landed on the intended channel."))}
# Step 6: Delineate watershed
message("Step 6/7: Delineating watershed...")
if (!file.exists(watershed_rast)) {
wbt_watershed(
d8_pntr = flow_dir,
pour_pts = snapped_point,
output = watershed_rast,
verbose_mode = FALSE)
}
message("Step 7/7: Finalizing output...")
if (!file.exists(watershed_vect)) {
wbt_raster_to_vector_polygons(
input = watershed_rast,
output = watershed_vect,
verbose_mode = FALSE)}
# rm(result)
result <- st_read(watershed_vect, quiet = TRUE)
result <- result |> st_make_valid()
file.remove(watershed_vect)
st_write(result, watershed_vect, quiet = TRUE)
# raster_to_vector_polygons can return disjoint parts. Dissolve so the
# area reported below is the whole basin, not just the first ring.
if (nrow(result) > 1) {
message(paste("Note:", nrow(result), "polygons returned, dissolving..."))
result <- st_sf(id = 1, geometry = st_union(result)) |> st_make_valid()
file.remove(watershed_vect)
st_write(result, watershed_vect, quiet = TRUE)
}
# Save if output path provided
if (!is.null(output_path)) {
st_write(result, output_path, delete_dsn = TRUE, quiet = TRUE)
message(paste("Watershed polygon saved to:", output_path))
}
area_km2 <- sum(as.numeric(st_area(result))) / 1e6
message(paste("Watershed area:", round(area_km2, 2), "km²"))
message("Watershed delineation complete!")
if (return_raster) {
result <- list(polygon = result, raster = rast(watershed_rast))}
}, error = function(e) {
message(paste("Error during watershed delineation:", e$message))
stop(e)
}, finally = {
})
return(result)
}
summ <- function(i = 22){
source("functions_app/app_2_db.R", local = TRUE)
on.exit(try(DBI::dbDisconnect(conn), silent = TRUE), add = TRUE)
print(i)
point_df <- df[i,]
