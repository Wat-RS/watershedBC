summ_safe <- function(i) {
tryCatch(summ(i), error = function(e) {
message("FAILED ", i, ": ", conditionMessage(e))
NULL
})
}
a <- summ_safe(i = 138)
a
mapview::mapview(a)
a <- summ_safe(i = 139)
mapview::mapview(a)
library(future.apply)
plan(multisession, workers = 10)
res <- future_lapply(seq_len(nrow(df)), summ_safe, future.seed = TRUE)
