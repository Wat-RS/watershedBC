.gitignore
# History files
.Rhistory
.Rapp.history
# R files
.RData
.Ruserdata
.Renviron
.Rproj.user
.gitattributes
# Example code in package build process
*-Ex.R
# Output files from R CMD build
/*.pdf
/*.tar
/*.tar.gz
*.pdf
*.tar
*.tar.gz
# Output files from R CMD check
/*.Rcheck/
# RStudio files
.Rproj.user/
# produced vignettes
vignettes/*.html
vignettes/*.pdf
# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth
# knitr and R markdown default cache directories
*_cache/
/cache/
# Temporary files created by R markdown
*.utf8.md
*.knit.md
cred.csv
/*.RMD
/*.rmd
/rsconnect/
/precompute/
/test/
/testing/
/monitoring_functions/
/paper/
/functions_model/
/functions_prep/
functions_prep/
packrat/lib*/
.Rprofile
test
renv
renv.lock
watershedBC_backup.tar
# Local history, sync-conflict copies, logs, scratch
*.Rhistory
*-UNBC-CKXK6F4*
*.log
example_jeremy.R
# Local data files (large data lives in PostGIS / S3)
*.sqlite
*.gpkg
*.html

